# Database Configuration
MONGODB_URI=mongodb://localhost:27017/intelpedia
# or for production: mongodb+srv://username:password@cluster.mongodb.net/database

# Wisp CMS Configuration
NEXT_PUBLIC_BLOG_ID=your_wisp_blog_id_here
NEXT_PUBLIC_BLOG_DISPLAY_NAME=IntelPedia
NEXT_PUBLIC_BLOG_COPYRIGHT=IntelPedia
NEXT_DEFAULT_METADATA_DEFAULT_TITLE=IntelPedia - Your Source for Knowledge
NEXT_PUBLIC_BLOG_DESCRIPTION=Discover the latest AI tools, image generation techniques, prompting strategies, and AI news.

# Site Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=your_google_analytics_id
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=your_yandex_site_verification

# GitHub Integration (for image uploads)
GITHUB_TOKEN=your_github_personal_access_token_here

# Admin Authentication
ADMIN_PASSWORD=your_bcrypt_hashed_admin_password_here
JWT_SECRET=your_jwt_secret_key_here
REVALIDATION_SECRET=your_revalidation_secret_here
OG_IMAGE_SECRET=your_og_image_secret_here
